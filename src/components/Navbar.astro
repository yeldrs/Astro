---
import Container from "./Container.astro";
import FlagIcon from "./icons/FlagIcon.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { defaultLang } from "../i18n/ui";
import { LOCALES } from "../i18n/locales";
import { useTranslations, getLocalizedPath, stripLocalePrefix, cleanPathname, stripTrailingSlash } from "../i18n/utils";

const lang: "en" | "fr" = Astro.currentLocale === "fr" ? "fr" : defaultLang;
const t = useTranslations(lang);
const otherLang: "en" | "fr" = lang === "en" ? "fr" : "en";

const currentPath = cleanPathname(Astro.url.pathname);

const homeHref = stripTrailingSlash(getRelativeLocaleUrl(lang, "/"));

// Navigation links definition with IDs for tracking.
// "/#projects" and "/#contact" are fragments on the homepage, not real routes — building
// them off getRelativeLocaleUrl(lang, "/#projects") concatenates to "/fr/#projects", whose
// path portion ("/fr/") 404s on GitHub Pages for the same reason homeHref needs
// stripTrailingSlash (build.format:'file' never emits dist/fr/index.html). Reuse the
// already-stripped homeHref instead.
const navLinks = [
  { name: t("nav.work"), href: `${homeHref}#projects`, id: "work" },
  { name: t("nav.about"), href: getRelativeLocaleUrl(lang, "/about"), id: "about" },
  { name: t("nav.contact"), href: `${homeHref}#contact`, id: "contact" },
];

const switcherHref = getLocalizedPath(currentPath, lang, otherLang);
const isHome = stripLocalePrefix(currentPath, lang) === "/";

const currentLangMeta = LOCALES[lang];
const otherLangMeta = LOCALES[otherLang];

// Extract the page name for tracking (e.g.: "home", "about", "900care")
const pageName = isHome ? "home" : currentPath.split("/").filter(Boolean).pop();

// Simplified logic for the initial active state
function getInitialActive(id: string, path: string) {
  if (id === "about" && stripLocalePrefix(path, lang).includes("/about")) return true;
  return false;
}
---

<nav
  id="main-navbar"
  class="py-md sticky top-0 z-[60] bg-background-primary/95 backdrop-blur-sm"
>
  <Container class="flex justify-between items-center">
    <a
      href={homeHref}
      id="nav-logo"
      data-umami-event={`nav-link-logo-from-${pageName}`}
      class:list={[
        "text-base transition duration-150 uppercase",
        isHome ? "font-extrabold text-text-body-primary" : "text-text-body-primary font-normal",
      ]}
    >
      Yassine El Idrissi
    </a>

    <div class="hidden md:flex items-center space-x-lg" role="menu">
      {
        navLinks.map((link) => {
          const isActive = getInitialActive(link.id, currentPath);
          return (
            <a
              href={link.href}
              id={`nav-link-${link.id}`}
              data-nav-id={link.id}
              data-umami-event={`nav-link-${link.id}-from-${pageName}`}
              data-umami-event-name={link.name}
              class:list={[
                "nav-item text-base uppercase transition duration-150",
                isActive
                  ? "font-extrabold text-text-body-accent"
                  : "font-normal text-text-body-primary",

              ]}
            >
              {link.name}
            </a>
          );
        })
      }
      <div class="relative" id="lang-switcher">
        <button
          type="button"
          id="lang-switcher-button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="lang-switcher-menu"
          aria-label={t("nav.languageSwitcher")}
          class="flex items-center gap-1.5 text-sm font-normal text-text-body-primary py-xxs"
        >
          <FlagIcon lang={lang} />
          <span class="uppercase">{currentLangMeta.label}</span>
        </button>

        <div
          id="lang-switcher-menu"
          role="menu"
          class="hidden absolute left-1/2 -translate-x-1/2 top-full mt-1.5 w-max rounded-lg border border-stroke-neutral-primary bg-background-primary shadow-sm overflow-hidden z-50"
        >
          <span
            role="menuitem"
            aria-current="true"
            class="flex items-center gap-2 px-sm py-xs text-sm font-semibold text-text-body-primary"
          >
            <FlagIcon lang={lang} />
            <span class="uppercase">{currentLangMeta.label}</span>
          </span>
          <a
            href={switcherHref}
            role="menuitem"
            id="nav-lang-switcher"
            data-umami-event={`nav-lang-switch-to-${otherLang}-from-${pageName}`}
            class="flex items-center gap-2 px-sm py-xs text-sm font-normal text-text-body-secondary hover:text-text-body-primary hover:bg-gray-50 transition-colors"
          >
            <FlagIcon lang={otherLang} />
            <span class="uppercase">{otherLangMeta.label}</span>
          </a>
        </div>
      </div>
    </div>

    <button
      id="mobile-menu-button"
      aria-label={t("nav.toggleMenu")}
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-umami-event={`nav-mobile-burger-from-${pageName}`}
      class="md:hidden text-text-body-primary relative h-10 w-10 flex items-center justify-center p-0"
    >
      <div id="burger-icon" class="w-6 h-6 absolute">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-full h-full"
        >
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="11" y1="18" x2="20" y2="18"></line>
        </svg>
      </div>
      <div id="close-icon" class="hidden w-6 h-6 absolute">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-full h-full"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </div>
      <div id="close-icon" class="hidden w-6 h-6 absolute">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </div>
    </button>
  </Container>
</nav>

<div
  id="mobile-menu"
  class="md:hidden fixed top-[72px] left-0 right-0 bottom-0 z-50 bg-background-primary/95 backdrop-blur-sm transition-opacity duration-300 ease-in-out opacity-0 invisible overflow-y-auto"
  aria-hidden="true"
  role="dialog"
>
  <Container class="flex flex-col space-y-lg pt-lg pb-xl">
    <div role="menu" class="flex flex-col space-y-lg">
      {
        navLinks.map((link) => {
          const isActive = getInitialActive(link.id, currentPath);
          return (
            <a
              href={link.href}
              data-nav-id={link.id}
              data-umami-event={`nav-mobile-link-${link.id}-from-${pageName}`}
              data-umami-event-name={link.name}
              class:list={[
                "text-base uppercase transition duration-150",
                isActive
                  ? "font-extrabold text-text-body-accent"
                  : "font-normal text-text-body-primary",
              ]}
            >
              {link.name}
            </a>
          );
        })
      }
      <div class="flex items-center gap-md pt-sm" role="group" aria-label={t("nav.languageSwitcher")}>
        <span class="flex items-center gap-1.5 text-sm font-semibold text-text-body-primary" aria-current="true">
          <FlagIcon lang={lang} />
          <span class="uppercase">{currentLangMeta.label}</span>
        </span>
        <a
          href={switcherHref}
          data-umami-event={`nav-mobile-lang-switch-to-${otherLang}-from-${pageName}`}
          class="flex items-center gap-1.5 text-sm font-normal text-text-body-secondary transition-colors hover:text-text-body-primary"
        >
          <FlagIcon lang={otherLang} />
          <span class="uppercase">{otherLangMeta.label}</span>
        </a>
      </div>
    </div>
  </Container>
</div>

<script>
  let navInteractionsInitialized = false;

  function setNavItemState(element: any, isActive: boolean, isLogo = false) {
    if (!element) return;

    element.classList.toggle("font-extrabold", isActive);
    element.classList.toggle("font-normal", !isActive);

    if (isLogo) {
      element.classList.remove("text-text-body-accent");
      element.classList.add("text-text-body-primary");
      return;
    }

    element.classList.toggle("text-text-body-accent", isActive);
    element.classList.toggle("text-text-body-primary", !isActive);
  }

  function setActiveNavItem(activeId: string | null) {
    const logo = document.getElementById("nav-logo");
    const workLinks = document.querySelectorAll('[data-nav-id="work"]');
    const aboutLinks = document.querySelectorAll('[data-nav-id="about"]');
    const contactLinks = document.querySelectorAll('[data-nav-id="contact"]');

    setNavItemState(logo, activeId === "logo", true);
    workLinks.forEach((link) => setNavItemState(link, activeId === "work"));
    aboutLinks.forEach((link) => setNavItemState(link, activeId === "about"));
    contactLinks.forEach((link) => setNavItemState(link, activeId === "contact"));
  }

  function updateNavActiveState() {
    const currentPath = window.location.pathname;
    const isHome = /^\/(fr\/?)?(index\.html)?$/.test(currentPath);
    const footer = document.getElementById("contact");
    const isNearFooter =
      !!footer && footer.getBoundingClientRect().top <= window.innerHeight + 120;

    if (isHome && isNearFooter) {
      setActiveNavItem("contact");
      return;
    }

    if (isHome && window.scrollY < 120) {
      setActiveNavItem("logo");
      return;
    }

    if (isHome) {
      const projectsSection = document.getElementById("projects");
      const projectsRect = projectsSection?.getBoundingClientRect();
      const isProjectsInView =
        !!projectsSection &&
        projectsRect !== undefined &&
        projectsRect.top <= window.innerHeight * 0.45 &&
        projectsRect.bottom >= window.innerHeight * 0.15;

      if (isProjectsInView) {
        setActiveNavItem("work");
        return;
      }
    }

    if (currentPath.includes("/about")) {
      setActiveNavItem("about");
      return;
    }

    setActiveNavItem(null);
  }

  function setupNavInteractions() {
    if (navInteractionsInitialized) return;
    navInteractionsInitialized = true;

    updateNavActiveState();

    document.addEventListener("click", (event: MouseEvent) => {
      const target = event.target as HTMLElement | null;
      const clickedLink = target?.closest("[data-nav-id]");
      const clickedLogo = target?.closest("#nav-logo");

      if (clickedLink) {
        const navId = clickedLink.getAttribute("data-nav-id");
        const currentPath = window.location.pathname;
        const isHome = /^\/(fr\/?)?(index\.html)?$/.test(currentPath);

        if (navId === "work") setActiveNavItem("work");
        if (navId === "about") setActiveNavItem("about");
        if (navId === "contact") {
          setActiveNavItem(isHome ? "contact" : null);
        }
      }

      if (clickedLogo) {
        setActiveNavItem("logo");
      }
    });

    window.addEventListener("scroll", updateNavActiveState, { passive: true });
    window.addEventListener("resize", updateNavActiveState);
  }

  function setupLangSwitcher() {
    const button = document.getElementById("lang-switcher-button");
    const menu = document.getElementById("lang-switcher-menu");
    const wrapper = document.getElementById("lang-switcher");
    if (!button || !menu || !wrapper) return;

    const closeMenu = () => {
      menu.classList.add("hidden");
      button.setAttribute("aria-expanded", "false");
    };

    const toggleMenu = () => {
      const isOpen = !menu.classList.contains("hidden");
      if (isOpen) {
        closeMenu();
      } else {
        menu.classList.remove("hidden");
        button.setAttribute("aria-expanded", "true");
      }
    };

    button.addEventListener("click", (event) => {
      event.stopPropagation();
      toggleMenu();
    });

    document.addEventListener("click", (event) => {
      if (!wrapper.contains(event.target as Node)) closeMenu();
    });

    document.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key === "Escape") closeMenu();
    });
  }

  function setupMobileMenu() {
    const mobileMenuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");
    const burgerIcon = document.getElementById("burger-icon");
    const closeIcon = document.getElementById("close-icon");

    if (!mobileMenuButton || !mobileMenu) return;

    const toggleMenu = () => {
      const isOpen = mobileMenu.classList.contains("opacity-100");

      if (isOpen) {
        mobileMenu.classList.remove("opacity-100", "visible");
        mobileMenu.classList.add("opacity-0", "invisible");
        burgerIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
        mobileMenuButton.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
      } else {
        mobileMenu.classList.remove("opacity-0", "invisible");
        mobileMenu.classList.add("opacity-100", "visible");
        burgerIcon?.classList.add("hidden");
        closeIcon?.classList.remove("hidden");
        mobileMenuButton.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
      }
    };

    mobileMenuButton.addEventListener("click", toggleMenu);

    const mobileMenuLinks = mobileMenu.querySelectorAll("a");
    mobileMenuLinks.forEach((link) => {
      link.addEventListener("click", toggleMenu);
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    setupNavInteractions();
    setupMobileMenu();
    setupLangSwitcher();
  });
  document.addEventListener("astro:after-swap", () => {
    setupNavInteractions();
    setupMobileMenu();
    setupLangSwitcher();
  });
</script>

<style>
  .nav-item,
  #nav-logo {
    transition: color 0.2s ease, font-weight 0.2s ease;
    will-change: color, font-weight;
  }
</style>
