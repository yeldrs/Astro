---
import Button from "./Button.astro";
import { defaultLang } from "../i18n/ui";
import { useTranslations, plainText } from "../i18n/utils";

export interface Props {
  headline: string;
  client: string;
  description?: string;
  role: string;
  projectLink: string;
  umamiSlug: string;
  imageAlt: string;
  imageUrl: string;
  direction?: "default" | "reverse";
  id?: string;
  lang?: "en" | "fr";
}

const {
  headline,
  client,
  description,
  role,
  projectLink,
  umamiSlug,
  imageAlt,
  imageUrl,
  direction = "default",
  id,
  lang = defaultLang,
} = Astro.props;

const t = useTranslations(lang);
const plainHeadline = plainText(headline);

// Stable Umami tracking key — the project's semanticSlug, not a derived label.
const projectSlugUmami = umamiSlug;

const directionClass = direction === "reverse" ? "md:flex-row-reverse" : "";
---

<article
  id={id ?? undefined}
  role="article"
  aria-label={plainHeadline}
  class={`flex flex-col md:flex-row gap-lg md:gap-3xl ${directionClass} md:items-start`}
>
  <h1
    class="h-display md:hidden m-0"
    set:html={headline}
  />

  <a
    href={projectLink}
    data-umami-event="project-image-click"
    data-umami-event-project={projectSlugUmami}
    aria-label={t("project.viewProjectAria", { headline: plainHeadline })}
    class="block group flex-1 md:basis-1/2 relative rounded-2xl aspect-[4/3] order-2 md:order-none overflow-hidden"
  >
    <img
      src={imageUrl}
      alt={imageAlt}
      class="absolute inset-0 w-full h-full object-cover block rounded-2xl transition-transform duration-500 group-hover:scale-90"
      loading="lazy"
    />
  </a>

  <section class="flex-1 md:basis-1/2 order-3 md:order-none flex flex-col gap-lg">
    <h1
       class="h-display hidden md:block m-0"
      set:html={headline}
    />
    <div class="space-y-lg">
      <div>
        <span class="block text-base font-normal text-text-body-tertiary mb-xxs"
          >{t("project.client")}</span
        >
        <p class="text-base font-normal text-text-body-primary">
          {client}
        </p>
      </div>

      <div>
        <span class="block text-base font-normal text-text-body-tertiary mb-xxs"
          >{t("project.description")}</span
        >
        <p class="text-base font-normal text-text-body-primary leading-normal">
          {description}
        </p>
      </div>

      <div>
        <span class="block text-base font-normal text-text-body-tertiary mb-xxs"
          >{t("project.role")}</span
        >
        <p class="text-base font-normal text-text-body-primary">
          {role}
        </p>
      </div>
    </div>
    <div>
      <Button
        href={projectLink}
        data-umami-event="project-button-click"
        data-umami-event-project={projectSlugUmami}
      >
        {t("project.viewProject")}
      </Button>
    </div>
  </section>
</article>
