---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import { useTranslations } from "../i18n/utils";

// GitHub Pages serves a single 404.html for any unmatched path regardless of
// locale prefix, so this page can't be locale-aware — it stays English.
const t = useTranslations("en");
const title = `404 | ${t("page404.title")}`;
---

<BaseLayout title={title} description={t("page404.body")}>
  <Container class="py-6xl flex flex-col items-center text-center gap-lg">
    <p
      class="h-display italic font-semibold text-heading-accent text-5xl md:text-6xl"
      aria-hidden="true"
    >
      404
    </p>

    <h1 class="h-display text-3xl md:text-4xl">
      {t("page404.title")}
    </h1>

    <p class="text-lg font-normal text-text-body-secondary max-w-[480px]">
      {t("page404.body")}
    </p>

    <Button
      href="/"
      class="mt-lg"
      data-umami-event="404-go-home-button"
    >
      {t("page404.goHome")}
    </Button>
  </Container>
</BaseLayout>
