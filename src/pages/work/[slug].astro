---
// src/pages/work/[slug].astro
import { getCollection } from "astro:content";
import ProjectLayout from "../../layouts/ProjectLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.isDraft !== true);
  return projects.map((project) => ({
    params: { slug: project.data.semanticSlug },
    props: { project, lang: "en" as const },
  }));
}

const { project, lang } = Astro.props;
---

<ProjectLayout project={project} lang={lang} />
