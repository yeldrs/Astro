---
// src/layouts/HomeLayout.astro
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import ProjectCard from "../components/ProjectCard.astro";
import Container from "../components/Container.astro";
import Hero from "../components/Hero.astro";
import Cloud from "../components/Cloud.astro";
import { useTranslations, plainText } from "../i18n/utils";
import { home as homeEn } from "../data/home.en";
import { home as homeFr } from "../data/home.fr";

export interface Props {
  lang: "en" | "fr";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = lang === "fr" ? homeFr : homeEn;

const PlaceholderImage = "/images/profile-pic.webp";

const allProjects = (await getCollection("projects"))
  .filter(({ data }) => data.isDraft !== true && (lang === "en" || data.fr != null))
  .map((project) => ({
    ...project,
    copy: lang === "fr" && project.data.fr ? project.data.fr : project.data.en,
  }))
  .sort(
    (a, b) =>
      new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime(),
  );
---

<div class="relative">
  <Cloud
    variant="large"
    shade={300}
    width="600px"
    blur="md"
    opacity={0.3}
    top="-20px"
    right="-150px"
    mobile={{ opacity: 0, top: "5vh", right: "35%" }}
  />

  <Cloud
    variant="small"
    shade={200}
    width="230px"
    blur="md"
    opacity={0.3}
    top="350px"
    left="80px"
    rotate={0}
    mobile={{ opacity: 0.3, top: "20px", left: "39%" }}
  />

  <Cloud
    variant="medium"
    shade={300}
    width="250px"
    blur="md"
    opacity={0.3}
    bottom="-90px"
    left="55%"
    mobile={{ opacity: 0.18, bottom: "-120px", left: "35%" }}
  />

  <Container class="px-lg pb-5xl flex flex-col gap-5xl md:gap-3xl">
    <section
      class="min-h-[calc(100svh-5rem)] flex flex-col justify-center items-center space-y-4xl px-lg"
    >
      <Hero
        title={home.heroTitle}
        subtitle={home.heroSubtitle}
        subtitleBreak={home.heroSubtitleBreak}
        profileImage={PlaceholderImage}
      />

      <div class="flex flex-col items-center gap-xl">
        <a
          href="#projects"
          class="bg-background-primary border border-stroke-neutral-primary rounded-full px-lg py-sm-d cursor-pointer transition hover:bg-gray-50 border-stroke-primary-hover shadow-sm text-text-body-accent text-md font-semibold"
        >
          {t("home.cta")}
        </a>

        <div class="text-stroke-primary-dark animate-bounce">
          <a href="#projects" aria-label={t("home.scrollAria")}>
            <svg
              width="16"
              height="39"
              viewBox="0 0 19 39"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              class="h-10 w-6"
            >
              <path
                d="M10.455 1.25C10.455 0.559644 9.89531 3.01764e-08 9.20496 0C8.5146 -3.01764e-08 7.95496 0.559644 7.95496 1.25L9.20496 1.25L10.455 1.25ZM8.32107 38.1339C8.80923 38.622 9.60068 38.622 10.0888 38.1339L18.0438 30.1789C18.5319 29.6908 18.5319 28.8993 18.0438 28.4112C17.5556 27.923 16.7642 27.923 16.276 28.4112L9.20495 35.4822L2.13389 28.4112C1.64573 27.923 0.854275 27.923 0.36612 28.4112C-0.122035 28.8993 -0.122035 29.6908 0.36612 30.1789L8.32107 38.1339ZM9.20496 1.25L7.95496 1.25L7.95495 37.25L9.20495 37.25L10.455 37.25L10.455 1.25L9.20496 1.25Z"
                fill="currentColor"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <section
      id="projects"
      role="region"
      aria-label={t("home.projectsAria")}
      class="flex flex-col space-y-6xl"
    >
      {
        allProjects.map((project, index) => (
          <ProjectCard
            id={project.data.semanticSlug}
            headline={project.copy.title}
            client={project.copy.client}
            description={project.copy.description}
            role={project.copy.role}
            projectLink={getRelativeLocaleUrl(lang, `/work/${project.data.semanticSlug}`)}
            umamiSlug={project.data.semanticSlug}
            imageAlt={t("home.projectPreviewAlt", { title: plainText(project.copy.title) })}
            imageUrl={project.data.cover}
            direction={index % 2 === 0 ? "reverse" : "default"}
            lang={lang}
          />
        ))
      }
    </section>
  </Container>
</div>
