---
// src/layouts/ProjectLayout.astro
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import BaseLayout from "./BaseLayout.astro";
import Container from "../components/Container.astro";
import ProjectCarousel from "../components/ProjectCarousel.astro";
import ProjectSection from "../components/ProjectSection.astro";
import ProjectFigure from "../components/ProjectFigure.astro";
import ArrowButton from "../components/ArrowButton.astro";
import { LOCALES } from "../i18n/locales";
import { useTranslations, plainText } from "../i18n/utils";

export interface Props {
  project: CollectionEntry<"projects">;
  lang: "en" | "fr";
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);

// Shared, language-neutral data + the translated copy block for this locale.
const data = project.data;
const copy = lang === "fr" && data.fr ? data.fr : data.en;

// Resolves an occasionally-localized credit string (see i18nString in config.ts).
const creditRole = (role?: string | { en: string; fr: string }): string | undefined =>
  typeof role === "string" || role === undefined ? role : role[lang];

const plainTitle = plainText(copy.title);

// context is optional and may be a bullet list (see keyInsights/metrics
// pattern) — meta description and JSON-LD both require a flat string, so
// collapse it here.
const contextSummary = Array.isArray(copy.context)
  ? copy.context.join(" ").replace(/<[^>]+>/g, "")
  : (copy.context ?? "").replace(/<[^>]+>/g, "");
const metaDescription = copy.description ?? contextSummary;

// Per-project structured data (schema.org CreativeWork) for search engines / AI agents
const seoBase = Astro.site ?? new URL("https://yassineelidrissi.com");
const projectLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: plainTitle,
  headline: plainTitle,
  description: metaDescription,
  url: new URL(getRelativeLocaleUrl(lang, `/work/${data.semanticSlug}`), seoBase).href,
  image: new URL(data.cover, seoBase).href,
  dateCreated: data.publishDate,
  inLanguage: LOCALES[lang].bcp47,
  creator: {
    "@type": "Person",
    name: "Yassine El Idrissi",
    url: seoBase.href,
  },
  about: copy.client,
};

// --- Image logic ---
// Named images are flattened back to the positional layout the sections below expect:
// [0/1] context · [2/3] role · [4/5] conception · [6/7] results · [8+] carousel.
const projectImages = [
  data.images.context.main,
  data.images.context.secondary,
  data.images.role.main,
  data.images.role.secondary,
  data.images.conception.main,
  data.images.conception.secondary,
  data.images.results.main,
  data.images.results.secondary,
  ...data.images.carousel,
];

// Main images (Index 0, 2, 4, 6)
const contextImage = projectImages[0] || data.cover || "";
const roleImage = projectImages[2] || "";
const conceptionImage = projectImages[4] || "";
const resultsImage = projectImages[6] || "";

// Optional images (Index 1, 3, 5, 7)
const contextImage2 = projectImages[1] || "";
const roleImage2 = projectImages[3] || "";
const conceptionImage2 = projectImages[5] || "";
const resultsImage2 = projectImages[7] || "";

// The carousel now starts at index 8
const carouselImages = projectImages.slice(8);
const allModalImages = projectImages;

const teamMembers = data.credits?.team ?? [];
const references = data.credits?.references ?? [];

// designConception has its own (paragraph + listItems) shape, so it stays inline
// rather than going through <ProjectSection>. Every other section field does.
const designConceptionList = copy.designConception?.listItems || [];
const hasDesignConception =
  Boolean(copy.designConception?.paragraph?.trim()) || designConceptionList.length > 0;

const tertiaryVariant = "tertiary";
const disabledVariant = "disabled";
---

<BaseLayout
  title={`${t("project.titlePrefix")} | ${plainTitle}`}
  description={metaDescription}
  image={data.cover}
  imageAlt={plainTitle}
  structuredData={projectLd}
>
  <Container>
    <div class="py-3xl max-w-content mx-auto space-y-3xl">
      <h1
        class="h-display"
        set:html={copy.title}
      />

      <section
        id={`${data.semanticSlug}-diagnosis`}
        role="region"
        aria-label={t("project.diagnosis")}
        class="space-y-3xl"
      >
        <h2 class="text-3xl font-normal text-text-body-primary mb-3xl">
          {t("project.diagnosis")}
        </h2>

        <article
          id={`${data.semanticSlug}-context-problem`}
          role="article"
          class="grid grid-cols-1 md:grid-cols-2 gap-y-3xl md:gap-x-4xl items-start"
        >
          <div class="space-y-md">
            <ProjectSection title={t("project.context")} value={copy.context} />
            <ProjectSection title={t("project.problem")} value={copy.problem} />
          </div>

          <div class="space-y-md">
            <ProjectFigure
              src={contextImage}
              alt={`${t("project.context")} ${t("project.visualization")}`}
            />
            <ProjectFigure
              src={contextImage2}
              alt={`${t("project.context")} ${t("project.visualizationSecondary")}`}
            />
          </div>
        </article>

        <article
          id={`${data.semanticSlug}-role-insights`}
          role="article"
          class="grid grid-cols-1 md:grid-cols-2 gap-y-3xl md:gap-x-4xl items-start"
        >
          <div class="space-y-md">
            <ProjectSection title={t("project.role")} value={copy.roleDescription} />
            <ProjectSection title={t("project.keyInsights")} value={copy.keyInsights} />
          </div>

          <div class="space-y-md">
            <ProjectFigure
              src={roleImage}
              alt={`${t("project.role")} ${t("project.visualization")}`}
            />
            <ProjectFigure
              src={roleImage2}
              alt={`${t("project.role")} ${t("project.visualizationSecondary")}`}
            />
          </div>
        </article>
      </section>

      <ProjectCarousel images={carouselImages} hideArrowsOnMobile={true} lang={lang} />

      <section
        id={`${data.semanticSlug}-conception`}
        role="region"
        aria-label={t("project.conception")}
        class="space-y-3xl"
      >
        <h2 class="text-3xl font-normal text-text-body-primary mb-3xl">
          {t("project.conception")}
        </h2>

        <article
          id="conception-main"
          role="article"
          class="grid grid-cols-1 md:grid-cols-2 gap-y-3xl md:gap-x-4xl items-start"
        >
          <div class="space-y-md">
            <ProjectSection title={t("project.methodology")} value={copy.methodology} />

            {
              hasDesignConception && (
                <div class="space-y-sm">
                  <h3 class="text-lg font-semibold text-text-body-secondary">
                    {t("project.designConception")}
                  </h3>
                  {copy.designConception?.paragraph && (
                    <div
                      set:html={copy.designConception.paragraph}
                      class="text-base text-text-body-primary leading-relaxed text-left"
                    />
                  )}
                  {designConceptionList.length > 0 && (
                    <ul class="list-disc pl-5 text-base text-text-body-primary leading-relaxed text-left">
                      {designConceptionList.map((item) => (
                        <li set:html={item} />
                      ))}
                    </ul>
                  )}
                </div>
              )
            }
          </div>

          <div class="space-y-md">
            <ProjectFigure
              src={conceptionImage}
              alt={`${t("project.conception")} ${t("project.visualization")}`}
            />
            <ProjectFigure
              src={conceptionImage2}
              alt={`${t("project.conception")} ${t("project.visualizationSecondary")}`}
            />
          </div>
        </article>
      </section>

      <section
        id={`${data.semanticSlug}-results`}
        role="region"
        aria-label={t("project.results")}
        class="space-y-3xl"
      >
        <h2 class="text-3xl font-normal text-text-body-primary mb-3xl">
          {t("project.results")}
        </h2>

        <article
          id={`${data.semanticSlug}-results-main`}
          role="article"
          class="grid grid-cols-1 md:grid-cols-2 gap-y-3xl md:gap-x-4xl items-start"
        >
          <div class="space-y-md">
            <ProjectSection title={t("project.delivery")} value={copy.delivery} />
            <ProjectSection title={t("project.metrics")} value={copy.metrics} />
          </div>

          <div class="space-y-md">
            <ProjectFigure
              src={resultsImage}
              alt={`${t("project.results")} ${t("project.visualization")}`}
            />
            <ProjectFigure
              src={resultsImage2}
              alt={`${t("project.results")} ${t("project.visualizationSecondary")}`}
            />
          </div>
        </article>
      </section>

      {/* ---------------------------------------------------- */}
      {/* CREDITS SECTION (FULLY OPTIONAL AND ROBUST) */}
      {/* ---------------------------------------------------- */}

      {
        (data.credits?.client ||
          teamMembers.length > 0 ||
          references.length > 0) && (
          <section
            id={`${data.semanticSlug}-credits`}
            role="contentinfo"
            aria-label={t("project.credits")}
            class="space-y-sm text-text-body-secondary mt-3xl border-t border-border-secondary pt-3xl"
          >
            <h2 class="text-base font-semibold text-text-body-primary">
              {t("project.credits")}
            </h2>

            <div class="text-xs space-y-xxs">
              <p>
                <>
                  <strong>{t("project.author")} : </strong>
                  <a
                    href="https://www.linkedin.com/in/yassineelidrissi/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link"
                  >
                    Yassine El Idrissi
                  </a>
                </>
              </p>

              {/* Line 1: Team (teamMembers) */}
              {teamMembers.length > 0 && (
                <p>
                  <strong>{t("project.collaboration")} :</strong>
                  {teamMembers.map((member, index) => {
                    if (!member.name) return null;
                    return (
                      <span>
                        <a
                          href={member.link || "#"}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="link"
                        >
                          {member.name}
                        </a>
                        {creditRole(member.role) && <span>, {creditRole(member.role)}</span>}
                        {index < teamMembers.length - 2
                          ? ", "
                          : index === teamMembers.length - 2
                            ? " and "
                            : ""}
                      </span>
                    );
                  })}
                </p>
              )}

              {/* Line 2: Client (shown when credits.client is set; name = the localized client) */}
              {data.credits?.client && (
                <p>
                  <strong>{t("project.client")} :</strong>{" "}
                  <a
                    href={data.credits.client.link || "#"}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link"
                  >
                    {copy.client}
                  </a>
                  .
                </p>
              )}

              {/* Line 3: References/Mentors */}
              {references.length > 0 && (
                <p>
                  <strong>{t("project.references")} :</strong>
                  {references.map((ref, index) => {
                    if (!ref.name) return null;
                    return (
                      <span>
                        <a
                          href={ref.link || "#"}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="link"
                        >
                          {ref.name}
                        </a>
                        {creditRole(ref.role) && <span>, {creditRole(ref.role)}</span>}
                        {index < references.length - 1 ? " | " : ""}
                      </span>
                    );
                  })}
                </p>
              )}
            </div>
          </section>
        )
      }
    </div>
  </Container>

  <div
    id="imageModal"
    class="fixed inset-0 z-[9999] bg-black/80 hidden items-center justify-center p-4 cursor-zoom-out"
    aria-modal="true"
    role="dialog"
    onclick="window.hideImageModal()"
  >
    {/* Close button */}
    <button
      id="closeModalBtn"
      class="absolute top-4 right-4 text-white text-3xl z-10 p-2 leading-none hover:text-red-400"
      aria-label={t("modal.close")}
      onclick="event.stopPropagation(); window.hideImageModal();"
    >
      &times;
    </button>

    <div
      class="relative flex items-center justify-center w-full h-full"
      onclick="event.stopPropagation()"
    >
      <ArrowButton
        id="modalPrevBtn"
        label={t("modal.previous")}
        direction="left"
        variant={disabledVariant as any}
        onClick="window.navigateModal(-1)"
        class="absolute left-0 z-10 transition-opacity disabled:opacity-30 disabled:pointer-events-none"
      />

      <img
        id="modalImage"
        data-current-modal-index="0"
        alt={t("modal.enlargedImageAlt")}
        class="max-w-full max-h-full object-contain"
      />

      <ArrowButton
        id="modalNextBtn"
        label={t("modal.next")}
        direction="right"
        variant={tertiaryVariant as any}
        onClick="window.navigateModal(1)"
        class="absolute right-0 z-10 transition-opacity disabled:opacity-30 disabled:pointer-events-none"
      />
    </div>
  </div>

  <script define:vars={{ images: allModalImages }} is:inline>
    // --- Fix for JS Robustness ---

    // 1. Definition of global-scope (or pseudo-global) variables
    const projectImages = images; // Use the variable passed by Astro
    const TOTAL_MODAL_IMAGES = projectImages.length;

    // Declare these variables on window for Astro SPA view transitions / navigation
    window.isModalOpen = false;
    window.isInitialized = false;

    // 2. Define the functions on the Window object for immediate accessibility

    window.navigateModal = function (direction) {
      const modalImg = document.getElementById("modalImage");
      if (!modalImg || TOTAL_MODAL_IMAGES <= 1 || !window.isModalOpen) return;

      let currentIndex = parseInt(modalImg.dataset.currentModalIndex) || 0;
      let newIndex = currentIndex + direction;

      // STOP logic at the ends
      if (newIndex >= TOTAL_MODAL_IMAGES || newIndex < 0) {
        return;
      }

      modalImg.src = projectImages[newIndex];
      modalImg.dataset.currentModalIndex = newIndex.toString();

      updateModalArrows(newIndex, TOTAL_MODAL_IMAGES);
    };

    window.showImageModal = function (imageUrl) {
      const modal = document.getElementById("imageModal");
      const modalImg = document.getElementById("modalImage");

      if (!modal || !modalImg || !imageUrl) return; // Stop if the elements are not there

      // New logic: If the modal is already open, hide it and retry to avoid state issues
      if (window.isModalOpen) {
        window.hideImageModal();
      }

      const initialIndex = projectImages.indexOf(imageUrl);
      let initialModalIndex = initialIndex === -1 ? 0 : initialIndex;

      modalImg.src = imageUrl;
      modalImg.dataset.currentModalIndex = initialModalIndex.toString();

      // Show the modal (important to do before modifying the state)
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      window.isModalOpen = true;

      // Handle the display of the arrows
      if (initialIndex !== -1 && TOTAL_MODAL_IMAGES > 1) {
        updateModalArrows(initialModalIndex, TOTAL_MODAL_IMAGES);
      } else {
        // Hide all arrows (single image or non-navigable)
        updateModalArrows(-1, 0);
      }

      modal.focus();
    };

    window.hideImageModal = function () {
      const modal = document.getElementById("imageModal");
      if (modal && window.isModalOpen) {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        window.isModalOpen = false;
      }
    };

    // --- Internal helper function (Uses the CSS disabling classes) ---

    function updateModalArrows(index, total) {
      const prevBtn = document.getElementById("modalPrevBtn");
      const nextBtn = document.getElementById("modalNextBtn");

      if (!prevBtn || !nextBtn) return;

      const hideAll = total <= 1 || index === -1;

      if (hideAll) {
        prevBtn.classList.add("hidden");
        nextBtn.classList.add("hidden");
      } else {
        prevBtn.classList.remove("hidden");
        nextBtn.classList.remove("hidden");
      }

      // Handling the 'disabled' state
      const isPrevDisabled = index <= 0;
      prevBtn.disabled = isPrevDisabled;

      const isNextDisabled = index >= total - 1;
      nextBtn.disabled = isNextDisabled;
    }

    function attachKeyboardHandler() {
      if (window.isInitialized) return;

      document.addEventListener("keydown", (event) => {
        if (window.isModalOpen) {
          if (event.key === "Escape") {
            window.hideImageModal();
          } else if (event.key === "ArrowLeft") {
            window.navigateModal(-1);
          } else if (event.key === "ArrowRight") {
            window.navigateModal(1);
          }
        }
      });
      window.isInitialized = true;
    }

    // --- Initialization ---
    // We use DOMContentLoaded to ensure the elements are in the DOM before attaching the handler
    document.addEventListener("DOMContentLoaded", () => {
      attachKeyboardHandler();
    });
    // We also attach on swap for Astro View Transitions
    document.addEventListener("astro:after-swap", attachKeyboardHandler);
  </script>

  <style>
    .prose {
      max-width: none;
    }
  </style>
</BaseLayout>
