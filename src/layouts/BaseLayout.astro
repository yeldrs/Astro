---
import "../styles/global.css";

// Fichier : src/layouts/BaseLayout.astro
import { getRelativeLocaleUrl } from "astro:i18n";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { defaultLang, ui } from "../i18n/ui";
import { LOCALES } from "../i18n/locales";
import { useTranslations, stripLocalePrefix, cleanPathname, stripTrailingSlash } from "../i18n/utils";

export interface Props {
  title: string;
  description?: string;
  image?: string; // relative path used for og:image / twitter:image
  imageAlt?: string; // alt text for the social preview image
  structuredData?: Record<string, unknown>; // extra JSON-LD injected in <head>
}

const lang: "en" | "fr" = Astro.currentLocale === "fr" ? "fr" : defaultLang;
const t = useTranslations(lang);

const {
  title,
  description = t("meta.defaultDescription"),
  image = "/images/og-default.jpg",
  imageAlt = "Yassine El Idrissi, UX Product Designer",
  structuredData,
} = Astro.props;

// Absolute URLs for SEO / social / structured data (Astro.site = https://yassineelidrissi.com)
const site = Astro.site ?? new URL("https://yassineelidrissi.com");
// build.format:'file' exposes paths as /about.html — strip the extension so the
// canonical/OG URL is always the clean, extensionless form GitHub Pages serves.
const cleanPath = cleanPathname(Astro.url.pathname);
const canonicalURL =
  new URL(cleanPath || "/", site).href.replace(/(.)\/$/, "$1");
const ogImage = new URL(image, site).href;

// hreflang alternates: strip the /fr prefix (if any) to get the locale-agnostic
// path, then rebuild it for each configured locale.
const pathWithoutLocale = stripLocalePrefix(cleanPath || "/", lang);
const alternateLinks = (Object.keys(ui) as Array<keyof typeof ui>).map(
  (locale) => ({
    hreflang: LOCALES[locale].bcp47,
    href: new URL(stripTrailingSlash(getRelativeLocaleUrl(locale, pathWithoutLocale)), site).href,
  }),
);

// Site-wide identity for search engines and AI agents
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Yassine El Idrissi",
  url: site.href,
  jobTitle: "UX Product Designer",
  sameAs: ["https://www.linkedin.com/in/yassineelidrissi/"],
  image: new URL("/images/profile-pic.webp", site).href,
  inLanguage: LOCALES[lang].bcp47,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang alternates for search engines -->
    {
      alternateLinks.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(stripTrailingSlash(getRelativeLocaleUrl(defaultLang, pathWithoutLocale)), site).href}
    />

    <!-- Open Graph (link previews on social + read by some AI crawlers) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yassine El Idrissi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={LOCALES[lang].ogLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Self-hosted fonts (see @font-face in global.css). No Google Fonts dependency. -->
    <link rel="preload" href="/fonts/manrope-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/lora-italic-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="52b0a573-2288-46c1-9e4f-a27cdae08238"></script>

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#4364e8" />
    <script>
      // Frustration-click detection: same bucket (element + ~40px radius) hit
      // repeatedly within a short window. Interactive elements (real links,
      // buttons, anything already carrying a data-umami-event) need 3 hits to
      // count as a "rage-click" — impatience, not necessarily a bug. Anything
      // else (a heading, an image with no link, plain text) needs only 2 —
      // that's someone expecting a click to do something that was never
      // going to. A non-empty text selection at fire time is skipped, since
      // that's almost always a double-click-to-select-a-word, not frustration.
      (function () {
        const WINDOW_MS = 1500;
        const RADIUS_PX = 40;
        const RAGE_THRESHOLD = 3;
        const DEAD_THRESHOLD = 2;

        let buffer: { el: Element; x: number; y: number; time: number }[] = [];

        function track(name: string, data: Record<string, string>) {
          if ((window as any).umami) (window as any).umami.track(name, data);
        }

        function isInteractive(el: Element): boolean {
          const tag = el.tagName;
          if (["A", "BUTTON", "INPUT", "SELECT", "TEXTAREA", "LABEL"].includes(tag)) return true;
          if (el.hasAttribute("data-umami-event")) return true;
          if (el.hasAttribute("onclick")) return true;
          const role = el.getAttribute("role");
          if (role && ["button", "link", "menuitem", "tab"].includes(role)) return true;
          const tabindex = el.getAttribute("tabindex");
          if (tabindex && tabindex !== "-1") return true;
          return false;
        }

        function closestInteractive(el: Element | null): Element | null {
          let node = el;
          while (node && node !== document.body) {
            if (isInteractive(node)) return node;
            node = node.parentElement;
          }
          return null;
        }

        function describeElement(el: Element): string {
          return (
            el.getAttribute("data-umami-event") ||
            el.id ||
            el.getAttribute("aria-label") ||
            (el.tagName === "A" && el.getAttribute("href")) ||
            el.textContent?.trim().slice(0, 40) ||
            el.tagName.toLowerCase()
          );
        }

        document.addEventListener("click", (event: MouseEvent) => {
          const target = event.target as Element | null;
          if (!target) return;

          const interactiveEl = closestInteractive(target);
          const bucketEl = interactiveEl || target;
          const isDeadCandidate = !interactiveEl;
          const threshold = isDeadCandidate ? DEAD_THRESHOLD : RAGE_THRESHOLD;

          const now = Date.now();
          buffer = buffer.filter((c) => now - c.time < WINDOW_MS);
          buffer.push({ el: bucketEl, x: event.clientX, y: event.clientY, time: now });

          const matches = buffer.filter(
            (c) =>
              c.el === bucketEl &&
              Math.abs(c.x - event.clientX) < RADIUS_PX &&
              Math.abs(c.y - event.clientY) < RADIUS_PX,
          );

          if (matches.length !== threshold) return;
          if (isDeadCandidate && (document.getSelection()?.toString().length ?? 0) > 0) return;

          track(isDeadCandidate ? "dead-click" : "rage-click", {
            element: describeElement(bucketEl),
            page: window.location.pathname,
          });
        });
      })();
    </script>

    <!-- Structured data: site-wide identity + optional per-page schema -->
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <style is:global>
      html,
      body {
        margin: 0;
        padding: 0;
        overflow-y: auto;
        overflow-x: hidden;
      }
    </style>
  </head>

 <body
    class="bg-background-page text-text-body-primary min-h-screen flex flex-col font-sans"
  >
    <header
      class="fixed inset-x-0 top-0 z-50 bg-background-primary border-b border-gray-200"
    >
      <Navbar />
    </header>

    <main class="flex-1 pt-4xl md:pt-3xl">
      <slot />
    </main>

    <Footer />
  </body>
</html>
